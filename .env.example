# Southern Cross Burgers — Environment Configuration
# Copy this file to .env.local for local development

# Payment Adapter: 'mock' (default offline simulator) or 'stripe' (Stripe Test Mode)
VITE_PAYMENT_ADAPTER=mock

# Stripe Test Mode Publishable Key (Frontend - safe to expose in test mode)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_test_publishable_key

# Stripe Test Mode Secret Key (Serverless ONLY - read exclusively by /api/create-payment-intent)
# NEVER prefix with VITE_ or commit a real secret key to git
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_secret_key
