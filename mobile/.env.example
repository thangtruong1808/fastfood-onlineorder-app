# Southern Cross Burgers — Expo Mobile Environment Variables (Test Mode Only)

# Payment Adapter: 'mock' (default offline simulator) or 'stripe' (Stripe Test Mode via backend)
EXPO_PUBLIC_PAYMENT_ADAPTER=mock

# Stripe Publishable Test Key (must start with pk_test_)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_test_key

# Base URL for serverless PaymentIntent API when using EXPO_PUBLIC_PAYMENT_ADAPTER=stripe
# On iOS Simulator: http://localhost:3000
# On Android Emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

