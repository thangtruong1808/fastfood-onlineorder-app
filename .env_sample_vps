# Copy this file to .env on the VPS, in the same folder as docker-compose.yml:
#   cp .env_sample_vps .env
#
# Docker Compose reads .env when it builds and starts the container.
# VITE_* values are baked into the frontend at image build time.
# After you change them, redeploy so the image is rebuilt.

# Port on the VPS that serves the site. Open this port in the firewall.
# Example: http://YOUR_VPS_IP:8080
APP_PORT=8080

# mock = offline demo payments (works with no Stripe account)
# stripe = real Stripe test mode (also set the publishable key below)
VITE_PAYMENT_ADAPTER=mock

# Stripe test publishable key (pk_test_...). Safe to expose in the frontend.
# Leave empty when VITE_PAYMENT_ADAPTER=mock.
VITE_STRIPE_PUBLISHABLE_KEY=

# Do not put STRIPE_SECRET_KEY here.
# This container only serves the static site. The secret key belongs on a server,
# and this Docker setup does not run /api/create-payment-intent.
